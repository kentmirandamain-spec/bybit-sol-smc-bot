# Copy to .env and fill in. NEVER commit or share this file.
# Bybit API key: permissions = Contract (Orders + Positions) ONLY. No withdrawal. IP-whitelist your server.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional overrides of config.yaml flags
# BOT_DRY_RUN=true
# BOT_TESTNET=false

# Optional: password for the local web dashboard (dashboard.py)
# DASHBOARD_PASSWORD=choose-a-password
# DASHBOARD_PORT=8080

# Optional: only needed when the GitHub repo is private, so the dashboard can check for updates.
# Fine-grained PAT: this repository only, Contents = Read-only. Leave unset if the repo is public.
# GITHUB_TOKEN=

# Optional Telegram alerts. Create a bot with @BotFather, then message the bot and
# read the chat id from https://api.telegram.org/bot<token>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
