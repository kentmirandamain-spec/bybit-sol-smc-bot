# Copy to .env and fill in. NEVER commit or share this file.
# Bybit API key: permissions = Contract (Orders + Positions) ONLY. No withdrawal. IP-whitelist your server.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional overrides of config.yaml flags
# BOT_DRY_RUN=true
# BOT_TESTNET=false

# Optional: password for the local web dashboard (dashboard.py)
# DASHBOARD_PASSWORD=choose-a-password
# DASHBOARD_PORT=8080
